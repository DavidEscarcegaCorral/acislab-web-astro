import About from '../components/sections/AboutSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import MembersSection from '../components/sections/MembersSection.astro';
import SoftwareSection from '../components/sections/SoftwareSection.astro';
---

<Layout isHome={true}>
    <main class="flex w-full flex-col px-4 md:px-0">
        <Hero />
        <About />
        <ProjectsSection />
        <SoftwareSection />
        <MembersSection />
    </main>
</Layout>
