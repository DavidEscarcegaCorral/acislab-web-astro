---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const getYear = (pubDate: string): number | null => {
    const match = pubDate.match(/\d{4}/);
    return match ? Number(match[0]) : null;
};

const allPublications = (await getCollection('publications')).sort((a, b) => {
    const yearA = getYear(a.data.pubDate) ?? 0;
    const yearB = getYear(b.data.pubDate) ?? 0;
    return yearB - yearA;
});

const years = [
    ...new Set(
        allPublications.map((p) => getYear(p.data.pubDate)).filter((y): y is number => y !== null),
    ),
].sort((a, b) => b - a);
---

<section class="min-h-screen w-full bg-white py-24">
    <div class="mx-auto max-w-4xl px-6">
        <div class="mb-12 text-center">
            <h1 class="text-brand-secondary mb-6 text-4xl font-bold md:text-5xl">Publications</h1>
            <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600">
                Explore our latest research contributions, conference papers, and academic articles.
            </p>
        </div>

        <div class="relative mx-auto mb-10 max-w-xl">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-slate-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <input
                type="text"
                id="search-input"
                class="focus:border-brand-secondary focus:ring-brand-secondary block w-full rounded-full border border-slate-200 bg-white py-3 pr-4 pl-11 leading-5 text-slate-700 placeholder-slate-400 shadow-sm transition-all focus:ring-1 focus:outline-none"
                placeholder="Search by title, author, or keyword..."
            />
        </div>

        <div class="mb-12 flex flex-wrap justify-center gap-4" id="filter-container">
            <button
                class="filter-btn active border-brand-secondary text-brand-secondary hover:bg-brand-secondary rounded-full border px-6 py-2 font-medium transition-all hover:text-white"
                data-year="all">
                All
            </button>
            {
                years.map((year) => (
                    <button
                        class="filter-btn hover:border-brand-secondary hover:text-brand-secondary rounded-full border border-slate-300 px-6 py-2 font-medium text-slate-600 transition-all"
                        data-year={year}>
                        {year}
                    </button>
                ))
            }
        </div>

        <div class="space-y-6" id="publications-list">
            {
                allPublications.length > 0 ? (
                    allPublications.map((pub) => (
                        <article
                            class="pub-card group hover:border-brand-primary/30 relative rounded-xl border border-slate-200 bg-white p-8 transition-all duration-300 hover:shadow-lg"
                            data-year={getYear(pub.data.pubDate)}>
                            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                                <div class="flex-1">
                                    <div class="mb-3 flex items-center gap-3 text-sm text-slate-500">
                                        <span class="rounded-full bg-slate-100 px-3 py-1 font-semibold text-slate-700">
                                            {pub.data.pubDate}
                                        </span>
                                        {!pub.data.url && (
                                            <span class="rounded border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-bold text-amber-600">
                                                Not available online yet
                                            </span>
                                        )}
                                    </div>

                                    <h3 class="pub-title mb-2 text-xl font-bold text-slate-900 transition-colors">
                                        {pub.data.url ? (
                                            <a
                                                href={pub.data.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="group-hover:text-brand-secondary hover:underline">
                                                {pub.data.title}
                                            </a>
                                        ) : (
                                            <span class="cursor-default">{pub.data.title}</span>
                                        )}
                                    </h3>

                                    <p class="pub-authors mb-3 text-sm font-medium text-slate-800">
                                        {pub.data.authors}
                                    </p>

                                    <p class="pub-desc text-sm leading-relaxed text-slate-600">
                                        {pub.data.description}
                                    </p>
                                </div>

                                {pub.data.url && (
                                    <div class="mt-4 shrink-0 md:mt-0">
                                        <a
                                            href={pub.data.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="group-hover:bg-brand-primary inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-50 text-slate-400 transition-all duration-300 group-hover:text-white"
                                            aria-label="View publication">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-5 w-5"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2">
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                )}
                            </div>
                        </article>
                    ))
                ) : (
                    <p class="text-center text-slate-500">No publications found.</p>
                )
            }
        </div>

        <div id="no-results" class="hidden py-12 text-center">
            <p class="text-lg text-slate-500">No publications found matching your criteria.</p>
        </div>
        <div id="pagination" class="mt-10 flex items-center justify-center gap-2"></div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const cards = Array.from(document.querySelectorAll('.pub-card')) as HTMLElement[];
        const noResults = document.getElementById('no-results');
        const searchInput = document.getElementById('search-input') as HTMLInputElement;
        const pagination = document.getElementById('pagination');

        const ITEMS_PER_PAGE = 5;
        let currentYear = 'all';
        let currentSearch = '';
        let currentPage = 1;

        const getFilteredCards = () => {
            return cards.filter((card) => {
                const cardYear = card.getAttribute('data-year');
                const title = card.querySelector('.pub-title')?.textContent?.toLowerCase() || '';
                const authors =
                    card.querySelector('.pub-authors')?.textContent?.toLowerCase() || '';
                const desc = card.querySelector('.pub-desc')?.textContent?.toLowerCase() || '';

                const contentMatch =
                    title.includes(currentSearch) ||
                    authors.includes(currentSearch) ||
                    desc.includes(currentSearch);

                const yearMatch = currentYear === 'all' || cardYear === currentYear;

                return yearMatch && contentMatch;
            });
        };

        const renderPagination = (totalItems: number) => {
            if (!pagination) return;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
            pagination.innerHTML = '';

            if (totalPages <= 1) return;

            const prev = document.createElement('button');
            prev.textContent = '←';
            prev.disabled = currentPage === 1;
            prev.type = 'button';
            prev.className = `px-3 py-1 rounded-full border transition-all ${
                currentPage === 1
                    ? 'border-slate-200 text-slate-300 cursor-not-allowed'
                    : 'border-slate-300 text-slate-600 hover:border-brand-secondary hover:text-brand-secondary'
            }`;
            prev.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    applyFilters();
                }
            });
            pagination.appendChild(prev);

            const getPageButtons = () => {
                const pages: (number | 'ellipsis')[] = [];
                const maxVisible = 5;
                
                if (totalPages <= maxVisible) {
                    for (let i = 1; i <= totalPages; i++) pages.push(i);
                } else {
                    pages.push(1);
                    
                    if (currentPage > 3) {
                        pages.push('ellipsis');
                    }
                    
                    const start = Math.max(2, currentPage - 1);
                    const end = Math.min(totalPages - 1, currentPage + 1);
                    
                    for (let i = start; i <= end; i++) {
                        pages.push(i);
                    }
                    
                    if (currentPage < totalPages - 2) {
                        pages.push('ellipsis');
                    }
                    
                    pages.push(totalPages);
                }
                return pages;
            };

            getPageButtons().forEach((page) => {
                if (page === 'ellipsis') {
                    const ellipsis = document.createElement('span');
                    ellipsis.textContent = '...';
                    ellipsis.className = 'px-2 text-slate-400';
                    pagination.appendChild(ellipsis);
                } else {
                    const btn = document.createElement('button');
                    btn.textContent = String(page);
                    btn.type = 'button';
                    btn.className = `px-4 py-1 rounded-full border font-medium transition-all ${
                        page === currentPage
                            ? 'bg-brand-secondary text-white border-brand-secondary'
                            : 'border-slate-300 text-slate-600 hover:border-brand-secondary hover:text-brand-secondary'
                    }`;
                    btn.addEventListener('click', () => {
                        currentPage = page;
                        applyFilters();
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                    pagination.appendChild(btn);
                }
            });

            const next = document.createElement('button');
            next.textContent = '→';
            next.disabled = currentPage === totalPages;
            next.type = 'button';
            next.className = `px-3 py-1 rounded-full border transition-all ${
                currentPage === totalPages
                    ? 'border-slate-200 text-slate-300 cursor-not-allowed'
                    : 'border-slate-300 text-slate-600 hover:border-brand-secondary hover:text-brand-secondary'
            }`;
            next.addEventListener('click', () => {
                if (currentPage < totalPages) {
                    currentPage++;
                    applyFilters();
                }
            });
            pagination.appendChild(next);
        };

        const applyFilters = () => {
            // Actualizar botones de año
            buttons.forEach((btn) => {
                const isSelected = btn.getAttribute('data-year') === currentYear;
                if (isSelected) {
                    btn.classList.add('bg-brand-secondary', 'text-white', 'border-brand-secondary');
                    btn.classList.remove(
                        'text-slate-600',
                        'border-slate-300',
                        'hover:border-brand-secondary',
                        'hover:text-brand-secondary',
                    );
                } else {
                    btn.classList.remove(
                        'bg-brand-secondary',
                        'text-white',
                        'border-brand-secondary',
                    );
                    btn.classList.add(
                        'text-slate-600',
                        'border-slate-300',
                        'hover:border-brand-secondary',
                        'hover:text-brand-secondary',
                    );
                }
            });

            const filtered = getFilteredCards();
            const start = (currentPage - 1) * ITEMS_PER_PAGE;
            const end = start + ITEMS_PER_PAGE;

            cards.forEach((card) => (card.style.display = 'none'));
            filtered.slice(start, end).forEach((card) => (card.style.display = 'block'));

            if (noResults) noResults.classList.toggle('hidden', filtered.length > 0);

            renderPagination(filtered.length);
        };

        // Filtros por año
        buttons.forEach((btn) => {
            btn.addEventListener('click', () => {
                currentYear = btn.getAttribute('data-year') || 'all';
                currentPage = 1;
                applyFilters();
            });
        });

        // Búsqueda
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
                currentPage = 1;
                applyFilters();
            });
        }

        // Carga inicial
        applyFilters();
    });
</script>
