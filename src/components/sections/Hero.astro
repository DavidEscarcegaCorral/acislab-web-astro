                </a>
            </div>

            <div class="px-4 text-center">
                <a href="/ComputationalModeling" class="group block">
                    <a href="/ComputionalModeling" class="group block">
                        <h2
                            class="font-brand group-hover:text-brand-secondary text-lg leading-snug font-bold tracking-wider text-black uppercase transition-all duration-300 group-hover:scale-105 md:text-xl lg:text-2xl xl:text-3xl">
                            Computational Modeling<br />of Emotion & Affective HCI
