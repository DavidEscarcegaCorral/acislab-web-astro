    class="mx-auto flex min-h-[50vh] max-w-7xl flex-col items-center justify-center gap-6 px-4 md:min-h-screen md:px-6">
    <div class="-mt-32 w-full text-center">
        <h1
            id="hero-title"
            class:list={[
                'font-brand text-brand-secondary text-5xl font-bold uppercase drop-shadow-sm',
                'mb-8 tracking-widest',
                'md:mb-16 md:pl-[0.3em] md:text-[10rem] md:tracking-[0.3em]',
            ]}>
            ACISLAB
        </h1>

        <div
            class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 md:grid-cols-2 md:gap-8 lg:gap-16 xl:gap-24">
            <div class="px-4 text-center">
                <a href="/HealthInformatics" class="group block">
                    <h2
                        class="font-brand group-hover:text-brand-secondary text-lg leading-snug font-bold tracking-wider text-black uppercase transition-all duration-300 group-hover:scale-105 md:text-xl lg:text-2xl xl:text-3xl">
                        Health Informatics<br />& Dementia Care
