---
import { getCollection, render } from 'astro:content';

const allProjects = await getCollection('projects');

const shuffled = allProjects.sort(() => Math.random() - 0.5).slice(0, 4);

const renderedProjects = await Promise.all(
    shuffled.map(async (project) => ({
        ...project,
        Content: (await render(project)).Content,
    })),
);
---

<section class="relative z-10 w-full bg-white px-6 py-20 md:px-20 md:py-32">
    <div class="mx-auto flex max-w-6xl flex-col md:flex-row">
        <div class="relative flex md:w-1/3 md:justify-end md:pr-10">
            <div class="bg-brand-secondary absolute -top-16 right-0 hidden h-20 w-px md:block">
            </div>
            <div class="bg-brand-secondary absolute top-32 right-0 bottom-0 hidden w-px md:block">
            </div>
            <h2
                class="text-brand-secondary text-7xl font-bold tracking-widest md:text-8xl lg:text-9xl">
                Our
            </h2>
        </div>

        <div class="mt-4 md:mt-0 md:w-2/3 md:pl-10">
            <h2
                class="text-brand-secondary mb-12 text-7xl font-bold tracking-widest md:text-8xl lg:text-9xl">
                Projects
            </h2>

            <div class="mb-10 flex w-full flex-col" id="projects-accordion">
                {
                    renderedProjects.map(({ data, id, Content }, index) => (
                        <div class="accordion-item border-brand-secondary border-t last:border-b">
                            <button
                                class="accordion-button hover:text-brand-secondary flex w-full items-center justify-between py-5 text-left text-lg text-slate-500 transition-colors md:text-xl"
                                aria-expanded="false"
                                aria-controls={`accordion-content-${index}`}
                                id={`accordion-btn-${index}`}>
                                <span class="accordion-title font-medium">
                                    {data.title ?? 'Project'}
                                </span>
                                <span class="icon text-3xl font-light transition-transform duration-300">
                                    +
                                </span>
                            </button>

                            <div
                                class="accordion-content grid transition-[grid-template-rows] duration-300 ease-in-out"
                                id={`accordion-content-${index}`}
                                role="region"
                                aria-labelledby={`accordion-btn-${index}`}>
                                <div class="overflow-hidden">
                                    {data.description && (
                                        <p class="pt-2 pb-4 text-base leading-relaxed text-slate-600 md:text-lg">
                                            {data.description}
                                        </p>
                                    )}
                                    <div class="prose prose-sm max-w-none pb-6 text-slate-600">
                                        <Content />
                                    </div>
                                    <div class="pt-2 pb-6">
                                        <a
                                            href={`/projects/${id.replace(/\.[^.]+$/, '')}`}
                                            class="text-brand-secondary hover:text-brand-secondary/80 group inline-flex items-center gap-2 text-sm font-bold tracking-wider uppercase transition-colors">
                                            View Project details
                                            <span class="transform transition-transform group-hover:translate-x-1">
                                                →
                                            </span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .accordion-content.is-open {
        grid-template-rows: 1fr;
    }
    .accordion-content {
        grid-template-rows: 0fr;
    }
</style>

<script>
    const container = document.getElementById('projects-accordion');
    if (container) {
        container.querySelectorAll<HTMLButtonElement>('.accordion-button').forEach((button) => {
            button.addEventListener('click', () => {
                const item = button.closest('.accordion-item');
                if (!item) return;

                const content = item.querySelector<HTMLElement>('.accordion-content');
                const icon = item.querySelector<HTMLElement>('.icon');
                const title = item.querySelector<HTMLElement>('.accordion-title');
                if (!content || !icon) return;

                const isOpen = button.getAttribute('aria-expanded') === 'true';

                // Cerrar todos dentro de este contenedor
                container.querySelectorAll<HTMLElement>('.accordion-content').forEach((c) => {
                    c.classList.remove('is-open');
                });
                container.querySelectorAll<HTMLButtonElement>('.accordion-button').forEach((b) => {
                    b.setAttribute('aria-expanded', 'false');
                    const i = b.closest('.accordion-item')?.querySelector<HTMLElement>('.icon');
                    const t = b
                        .closest('.accordion-item')
                        ?.querySelector<HTMLElement>('.accordion-title');
                    if (i) i.style.transform = 'rotate(0deg)';
                    if (t) t.classList.remove('text-brand-secondary');
                });

                // Abrir si estaba cerrado
                if (!isOpen) {
                    content.classList.add('is-open');
                    button.setAttribute('aria-expanded', 'true');
                    icon.style.transform = 'rotate(45deg)';
                    title?.classList.add('text-brand-secondary');
                }
            });
        });
    }
</script>
