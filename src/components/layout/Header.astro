---
import ButtonGroup from '../ui/ButtonGroup.astro';
---

<header id="site-header" class="fixed top-0 left-0 z-50 w-full bg-white">
    <div class="mx-auto flex max-w-7xl items-center px-6 py-4">
        <a
            id="header-logo"
            href="/"
            class="text-brand-secondary pointer-events-none mr-8 -translate-x-4 text-xl font-bold tracking-widest uppercase opacity-0 transition-all duration-500 ease-out">
            ACISLAB
        </a>

        <div class="flex flex-1 justify-center">
            <ButtonGroup />
        </div>
    </div>
</header>

<script>
    const logo = document.getElementById('header-logo');
    const hero = document.querySelector('[data-hero]');

    if (logo && hero) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) {
                    // mostrar logo
                    logo.classList.remove('opacity-0', '-translate-x-4', 'pointer-events-none');
                    logo.classList.add('opacity-100', 'translate-x-0');
                } else {
                    // ocultar logo
                    logo.classList.add('opacity-0', '-translate-x-4', 'pointer-events-none');
                    logo.classList.remove('opacity-100', 'translate-x-0');
                }
            },
            { threshold: 0 },
        );
        observer.observe(hero);
    }
</script>
