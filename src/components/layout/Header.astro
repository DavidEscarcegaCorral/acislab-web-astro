---
import ButtonGroup from '../ui/ButtonGroup.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---

<header
    id="site-header"
    class="fixed top-0 left-0 z-50 w-full bg-white transition-all duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 md:justify-center md:px-6">
        <button
            id="mobile-menu-toggle"
            class="flex flex-col justify-center items-center w-10 h-10 gap-1.5 md:hidden"
            aria-label="Toggle menu"
            aria-expanded="false">
            <span class="menu-line w-6 h-0.5 bg-slate-700 transition-all duration-300 origin-center"></span>
            <span class="menu-line w-6 h-0.5 bg-slate-700 transition-all duration-300"></span>
            <span class="menu-line w-6 h-0.5 bg-slate-700 transition-all duration-300 origin-center"></span>
        </button>

        <a
            id="header-logo"
            href="/"
            class:list={[
                'text-brand-secondary overflow-hidden text-xl font-bold tracking-widest whitespace-nowrap uppercase transition-all duration-500 ease-in-out',
                isHome ? 'pointer-events-none mr-0 w-0 opacity-0' : 'w-[130px] opacity-100',
            ]}>
            ACISLAB
        </a>

        <ButtonGroup />
    </div>
</header>

<script>
    const logo = document.getElementById('header-logo');
    const heroTitle = document.getElementById('hero-title');
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLines = document.querySelectorAll('.menu-line');
    const body = document.body;

    const closeMenu = () => {
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('flex');
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuLines[0]?.classList.remove('rotate-45', 'translate-y-2');
        menuLines[1]?.classList.remove('opacity-0');
        menuLines[2]?.classList.remove('-rotate-45', '-translate-y-2');
        body.style.overflow = '';
    };

    const openMenu = () => {
        mobileMenu?.classList.remove('hidden');
        mobileMenu?.classList.add('flex');
        menuToggle?.setAttribute('aria-expanded', 'true');
        menuLines[0]?.classList.add('rotate-45', 'translate-y-2');
        menuLines[1]?.classList.add('opacity-0');
        menuLines[2]?.classList.add('-rotate-45', '-translate-y-2');
        body.style.overflow = 'hidden';
    };

    menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
            closeMenu();
        } else {
            openMenu();
        }
    });

    mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (e) => {
        if (!menuToggle?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
            closeMenu();
        }
    });

    if (logo && heroTitle) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) {
                    logo.classList.remove('w-0', 'opacity-0', 'mr-0', 'pointer-events-none');
                    logo.classList.add('w-[130px]', 'opacity-100', 'mr-8');
                } else {
                    logo.classList.add('w-0', 'opacity-0', 'mr-0', 'pointer-events-none');
                    logo.classList.remove('w-[130px]', 'opacity-100', 'mr-8');
                }
            },
            {
                threshold: 0,
                rootMargin: '-80px 0px 0px 0px',
            },
        );

        observer.observe(heroTitle);
    }
</script>
