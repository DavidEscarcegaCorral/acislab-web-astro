---
import ButtonGroup from '../ui/ButtonGroup.astro';
---

<header
    id="site-header text-"
    class="fixed top-0 left-0 z-50 w-full bg-white"
>
    <div
        class="text- mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
    >
        <a
            href="/"
            class="flex items-center gap-3"
        >
            <img
                src="/images/logo_ACISLAB.png"
                alt="ACISLAB"
                class="h-10"
            />
        </a>
        <ButtonGroup />
    </div>
</header>
