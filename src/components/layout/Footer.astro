---
const currentYear = new Date().getFullYear();
---

<footer class="px-6 pt-4 pb-8">
    <div
        class="bg-acislab-gray rounded-3xl px-10 py-14 text-white shadow-[0_20px_20px_-10px_rgba(0,0,0,0.5)]">
        <div class="grid grid-cols-1 gap-32 md:grid-cols-3">
            <!-- Logo y descripción -->
            <div class="space-y-4">
                <h3 class="text-2xl font-bold tracking-widest uppercase">ACISLAB</h3>
                <p class="max-w-xs text-base leading-relaxed text-white/80">
                    Advanced research in human-centered AI, affective computing, and healthcare
                    systems.
                </p>
            </div>

            <!-- Contact -->
            <div>
                <h4 class="mb-6 text-lg font-semibold tracking-widest uppercase">Contact</h4>
                <ul class="space-y-3 text-sm text-white/90">
                    <li class="flex items-start gap-2">
                        <span>Instituto Tecnológico de Sonora, Mexico</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4 shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2">
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        <span>luis.rodriguez@itson.edu.mx</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="mt-0.5 h-4 w-4 shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2">
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span
                            >Edificio AV1800, Cubículo 25, Campus Náinari. Ciudad Obregón, Sonora.</span
                        >
                    </li>
                    <li class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4 shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2">
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"
                            ></path>
                        </svg>
                        <span>(644)4109000 Ext. 1525</span>
                    </li>
                </ul>
            </div>

            <!-- Relations -->
            <div>
                <h4 class="mb-6 text-lg font-semibold tracking-widest uppercase">Relations</h4>
                <ul class="space-y-2 text-sm text-white/90">
                    <li>
                        <a
                            href="https://www.itson.mx/portalinstitucional/"
                            class="transition hover:text-white hover:underline">ITSON Oficial</a
                        >
                    </li>
                    <li>
                        <a href="#" class="transition hover:text-white hover:underline"
                            >Convocatorias</a
                        >
                    </li>
                    <li>
                        <a href="#" class="transition hover:text-white hover:underline"
                            >Colaboradores externos</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <!-- Copyright -->
        <div class="mt-12 pt-6 text-sm text-white">
            © {currentYear} ACISLAB. All rights reserved.
        </div>
    </div>
</footer>
