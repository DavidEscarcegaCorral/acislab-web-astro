---
const currentYear = new Date().getFullYear();
---

<footer
    class="relative mt-24 bg-gradient-to-r from-[#020617] via-[#020617] to-[#020617] text-slate-300">
    <div class="mx-auto max-w-7xl px-6 py-20">
        <div class="grid grid-cols-1 gap-14 md:grid-cols-4">
            <div class="space-y-4">
                <div class="flex items-center gap-2">
                    <img src="/images/logo_ACISLAB.png" alt="ACISLAB" class="h-8 w-auto" />
                </div>
                <p class="max-w-xs text-sm leading-relaxed text-slate-400">
                    Advanced research in human-centered AI, affective computing, and healthcare
                    systems.
                </p>
            </div>
            <div>
                <h4 class="mb-4 font-semibold text-white">Explore</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="/public" class="transition hover:text-sky-400">Home</a>
                    </li>
                    <li>
                        <a href="/Theses" class="transition hover:text-sky-400">Theses and papers</a
                        >
                    </li>
                    <li>
                        <a href="/Research" class="transition hover:text-sky-400">Research</a>
                    </li>
                    <li>
                        <a href="/Members" class="transition hover:text-sky-400">Members</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="mb-4 font-semibold text-white">Contact</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li class="flex items-start gap-2">
                        <span>-</span>
                        <span>luis.rodriguez@itson.edu.mx</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span>-</span>
                        <span> Instituto Tecnológico de Sonora (ITSON), Cd. Obregón, México. </span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span>-</span>
                        <span>(644) 4109000 Ext. 1525</span>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="mb-4 font-semibold text-white">Relations</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="#" class="transition hover:text-sky-400">ITSON Oficial</a>
                    </li>
                    <li>
                        <a href="#" class="transition hover:text-sky-400">Convocatorias</a>
                    </li>
                    <li>
                        <a href="#" class="transition hover:text-sky-400">Colaboradores Externos</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="mt-16 border-t border-slate-800"></div>

        <div class="mt-6 text-center text-xs text-slate-500">
            © {currentYear} ACISLAB. All rights reserved.
        </div>
    </div>
</footer>
