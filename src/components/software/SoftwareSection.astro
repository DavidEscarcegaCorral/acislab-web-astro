---

---

<section
    class="relative z-50 flex min-h-[60vh] w-full items-center justify-center overflow-hidden bg-white px-6 py-24 md:min-h-[80vh]">
    <div
        class="relative flex w-full max-w-7xl flex-col items-center justify-center"
        id="software-hero-container">
        <div class="absolute top-1/4 z-0 md:top-1/4 lg:-ml-32" data-software-anim="left">
            <h2
                class="text-7xl font-bold tracking-widest text-gray-200/80 uppercase md:text-9xl lg:text-[12rem]">
                ACISLAB
            </h2>
        </div>

        <div class="relative z-10 mt-12 md:mt-24 lg:mt-32 lg:ml-32" data-software-anim="right">
            <h1 class="text-6xl font-bold tracking-wide text-[#3b82f6] md:text-8xl lg:text-[10rem]">
                Software
            </h1>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Elementos
    const textLeft = document.querySelector('[data-software-anim="left"]');
    const textRight = document.querySelector('[data-software-anim="right"]');
    const container = document.querySelector('#software-hero-container');

    // Estado incial
    gsap.set(textLeft, { opacity: 0, x: -150 });
    gsap.set(textRight, { opacity: 0, x: 150 });

    // Linea de tiempo
    const tlSoftware = gsap.timeline({
        scrollTrigger: {
            trigger: container,
            start: 'top 85%',
            end: 'center 50%',
            scrub: 1,
        },
    });

    // Animacion
    tlSoftware
        .to(
            textLeft,
            {
                opacity: 1,
                x: 0,
                ease: 'none',
            },
            0,
        )
        .to(
            textRight,
            {
                opacity: 1,
                x: 0,
                ease: 'none',
            },
            0,
        );
</script>
