---
const { href } = Astro.props;
---

<a
    href={href}
    class="text-1xl text-acislab-gray inline-flex items-center gap-x-3 rounded-lg border border-transparent bg-transparent px-6 py-2 font-medium transition-all duration-400 ease-in-out hover:border-white/20 hover:bg-white hover:text-blue-600 hover:shadow-lg hover:shadow-blue-500/30 active:scale-95">
    <slot />
</a>
