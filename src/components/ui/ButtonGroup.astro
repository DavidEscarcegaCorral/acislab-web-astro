---
import LinkButton from './LinkButton.astro';

const currentPath = Astro.url.pathname;

const researchAreas = [
    {
        label: 'Affective Computing & Intelligent Systems',
        href: '/AffectiveComputing',
    },
    {
        label: 'Healthcare-Centered Systems',
        href: '/HealthCareSystems',
    },
];

const links = [
    {
        label: 'Publications',
        href: '/Publications',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19 3a3 3 0 0 1 2.995 2.824l.005 .176v12a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-12a3 3 0 0 1 2.824 -2.995l.176 -.005h14zm-2 12h-10l-.117 .007a1 1 0 0 0 0 1.986l.117 .007h10l.117 -.007a1 1 0 0 0 0 -1.986l-.117 -.007zm0 -4h-10l-.117 .007a1 1 0 0 0 0 1.986l.117 .007h10l.117 -.007a1 1 0 0 0 0 -1.986l-.117 -.007zm0 -4h-10l-.117 .007a1 1 0 0 0 0 1.986l.117 .007h10l.117 -.007a1 1 0 0 0 0 -1.986l-.117 -.007z"/></svg>`,
    },
    {
        label: 'Software',
        href: '/Software',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9h-18v-9z"/><path d="M2 18h20l-2 2h-16z"/></svg>`,
    },
    {
        label: 'People',
        href: '/People',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/></svg>`,
    },
    {
        label: 'Contact',
        href: '/Contact',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 6v12a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2"/><path d="M10 16h6"/><path d="M11 11a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M4 8h3"/><path d="M4 12h3"/><path d="M4 16h3"/></svg>`,
    },
];
---

<div class="flex flex-col items-center justify-center gap-8 px-4 md:flex-row">
    <div class="group relative">
        <LinkButton
            href="/OurResearch"
            active={currentPath.startsWith('/OurResearch') ||
                currentPath.startsWith('/AffectiveComputing') ||
                currentPath.startsWith('/HealthCare')}>
            Our research
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                    d="M21 16.008v-8.018a1.98 1.98 0 0 0 -1 -1.717l-7 -4.008a2.016 2.016 0 0 0 -2 0l-7 4.008c-.619 .355 -1 1.01 -1 1.718v8.018c0 .709 .381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7 -4.008c.619 -.355 1 -1.01 1 -1.718"
                ></path>
                <path d="M12 22v-10"></path>
                <path d="M12 12l8.73 -5.04"></path>
                <path d="M3.27 6.96l8.73 5.04"></path>
            </svg>
        </LinkButton>

        <div
            class="invisible absolute top-full left-0 mt-3 w-72 translate-y-2 scale-95 rounded-xl border border-slate-200 bg-white opacity-0 shadow-lg transition-all duration-300 ease-out group-hover:visible group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100">
            <ul class="py-2">
                {
                    researchAreas.map((area) => (
                        <li>
                            <a
                                href={area.href}
                                class={`hover:text-acislab-blue block px-5 py-3 text-sm transition-colors hover:bg-slate-50 ${
                                    currentPath === area.href
                                        ? 'text-acislab-blue font-bold'
                                        : 'text-slate-700'
                                }`}>
                                <span class="block font-semibold">{area.label}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    {
        links.map(({ label, href, icon }) => (
            <LinkButton href={href} active={currentPath === href}>
                {label}
                <Fragment set:html={icon} />
            </LinkButton>
        ))
    }

    <slot />
</div>
