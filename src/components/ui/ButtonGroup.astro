---
import PageButton from './PageButton.astro';

const currentPath = Astro.url.pathname;

const researchAreas = [
    {
        label: 'Computational Modeling of Emotion & Affective HCI',
        href: '/ComputionalModelingEmotional',
    },
    {
        label: 'Health Informatics & Dementia Care',
        href: '/HealthInformatics',
    },
];

const links = [
    {
        label: 'Publications',
        href: '/Publications',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19 3a3 3 0 0 1 2.995 2.824l.005 .176v12a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-12a3 3 0 0 1 2.824 -2.995l.176 -.005h14zm-2 12h-10l-.117 .007a1 1 0 0 0 0 1.986l.117 .007h10l.117 -.007a1 1 0 0 0 0 -1.986l-.117 -.007zm0 -4h-10l-.117 .007a1 1 0 0 0 0 1.986l.117 .007h10l.117 -.007a1 1 0 0 0 0 -1.986l-.117 -.007zm0 -4h-10l-.117 .007a1 1 0 0 0 0 1.986l.117 .007h10l.117 -.007a1 1 0 0 0 0 -1.986l-.117 -.007z"/></svg>`,
    },
    {
        label: 'People',
        href: '/People',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/></svg>`,
    },
    {
        label: 'Contact',
        href: '/Contact',
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 6v12a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2"/><path d="M10 16h6"/><path d="M11 11a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M4 8h3"/><path d="M4 12h3"/><path d="M4 16h3"/></svg>`,
    },
];
---

<nav
    id="mobile-menu"
    class="fixed inset-0 top-16 z-40 flex-col items-center justify-start pt-8 bg-white md:relative md:top-0 md:z-auto md:flex-row md:bg-transparent md:border-b-0 md:shadow-none md:py-0 md:px-0 hidden md:flex">
    <div class="flex flex-col items-center justify-center gap-8 w-full px-4 md:flex-row md:justify-center md:gap-8">
        <div class="group relative w-full md:w-auto">
            <button
                type="button"
                class:list={[
                    "flex items-center justify-center gap-2 px-6 py-4 text-lg font-medium rounded-xl transition-all md:px-4 md:py-2 md:text-base md:rounded-none md:w-auto w-full",
                    currentPath.startsWith('/ComputionalModelingEmotional') || currentPath.startsWith('/HealthInformatics')
                        ? 'bg-brand-secondary/10 text-brand-secondary md:bg-transparent md:text-brand-secondary md:border-b-2 md:border-brand-secondary'
                        : 'text-slate-700 hover:bg-slate-100 md:hover:bg-transparent md:hover:text-brand-secondary'
                ]}>
                Our research
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5 transition-transform duration-200 md:group-hover:rotate-180">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M6 9l6 6 6-6"></path>
                </svg>
            </button>

            <div
                id="research-dropdown"
                class="hidden md:hidden w-full">
                <div class="flex flex-col gap-2 py-4 px-6">
                    <a
                        href="/ComputionalModelingEmotional"
                        class:list={[
                            "text-lg font-medium py-3 px-4 rounded-xl transition-colors",
                            currentPath.startsWith('/ComputionalModelingEmotional')
                                ? 'bg-brand-secondary/10 text-brand-secondary'
                                : 'text-slate-600 hover:bg-slate-100'
                        ]}>
                        Computational Modeling of Emotion & Affective HCI
                    </a>
                    <a
                        href="/HealthInformatics"
                        class:list={[
                            "text-lg font-medium py-3 px-4 rounded-xl transition-colors",
                            currentPath.startsWith('/HealthInformatics')
                                ? 'bg-brand-secondary/10 text-brand-secondary'
                                : 'text-slate-600 hover:bg-slate-100'
                        ]}>
                        Health Informatics & Dementia Care
                    </a>
                </div>
            </div>

            <div
                class="hidden md:block invisible absolute top-full left-1/2 -translate-x-1/2 mt-3 w-72 translate-y-2 scale-95 rounded-xl border border-slate-200 bg-white opacity-0 shadow-lg transition-all duration-300 ease-out group-hover:visible group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 md:left-0 md:translate-x-0">
                <ul class="py-2">
                    {
                        researchAreas.map((area) => (
                            <li>
                                <a
                                    href={area.href}
                                    class={`hover:text-acislab-blue block px-5 py-3 text-sm transition-colors hover:bg-slate-50 ${
                                        currentPath === area.href
                                            ? 'text-acislab-blue font-bold'
                                            : 'text-slate-700'
                                    }`}>
                                    <span class="block font-semibold">{area.label}</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        {
            links.map(({ label, href, icon }) => (
                <PageButton href={href} active={currentPath === href}>
                    {label}
                    <Fragment set:html={icon} />
                </PageButton>
            ))
        }
        <slot />
    </div>
</nav>

<script>
    const mobileMenu = document.getElementById('mobile-menu');
    const researchButton = mobileMenu?.querySelector('button');
    const researchDropdown = document.getElementById('research-dropdown');

    const closeResearchDropdown = () => {
        researchDropdown?.classList.add('hidden');
    };

    const toggleResearchDropdown = () => {
        const isHidden = researchDropdown?.classList.contains('hidden');
        if (isHidden) {
            researchDropdown?.classList.remove('hidden');
        } else {
            closeResearchDropdown();
        }
    };

    researchButton?.addEventListener('click', (e) => {
        if (window.innerWidth < 768) {
            e.preventDefault();
            e.stopPropagation();
            toggleResearchDropdown();
        }
    });

    researchDropdown?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeResearchDropdown);
    });

    document.addEventListener('click', (e) => {
        if (!researchButton?.contains(e.target as Node) && !researchDropdown?.contains(e.target as Node)) {
            closeResearchDropdown();
        }
    });
</script>
