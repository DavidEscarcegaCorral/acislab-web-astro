---
import { Image } from 'astro:assets';
import itsonImg from '../assets/itson-scaled.jpg';
---

<section class="w-full bg-white px-6 py-12 md:px-20 md:py-24">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-10 md:flex-row md:gap-16">
        <div class="order-2 flex-1 text-center md:order-1 md:text-left">
            <h2 class="text-brand-secondary mb-8 text-3xl font-bold tracking-tight md:text-5xl">
                About us
            </h2>
            <div class="space-y-6 text-base leading-relaxed text-slate-600 lg:text-lg">
                <p>
                    ACISLAB is a research laboratory based at the Instituto Tecnológico de Sonora
                    (ITSON), Mexico, dedicated to the study and development of human-centered
                    artificial intelligence.
                </p>
                <p>
                    Our mission is to design intelligent systems that not only optimize tasks, but
                    are capable of understanding, modeling, and responding to the human cognitive
                    and emotional condition.
                </p>
                <p>
                    Our research spans foundational work in affective computing and intelligent
                    systems, as well as applied research in healthcare informatics.
                </p>
            </div>
        </div>

        <div class="order-1 w-full flex-1 md:order-2">
            <div class="group relative">
                <div
                    class="absolute -right-4 -bottom-4 -z-10 hidden h-full w-full rounded-2xl border-2 border-blue-600 md:block"
                >
                </div>

                <Image
                    src={itsonImg}
                    alt="ITSON Building"
                    width={600}
                    height={400}
                    format="webp"
                    class="h-auto w-full transform rounded-2xl object-cover shadow-xl transition-transform duration-500 group-hover:scale-[1.02]"
                />
            </div>
        </div>
    </div>
</section>
