---
import ResearchAreaCard from "./ResearchAreaCard.astro";
import healthImage from "../../assets/healthcare.png";
import affectiveImage from "../../assets/affective.png";

const areas = [
    {
        title: "Healthcare-Centered Systems",
        description:
            "Design and application of intelligent systems to support healthcare processes, caregivers, and patients.",
        image: healthImage,
        link: "/HealthCareSystems",
    },
    {
        title: "Affective Computing & Intelligent Systems",
        description:
            "Systems capable of understanding, modeling, and responding to human cognitive and emotional conditions.",
        image: affectiveImage,
        link: "/AffectiveComputing",
    },
];
---

<section class="mx-auto max-w-7xl px-6 pb-12 md:pb-16">
    <div class="mb-12 flex items-center gap-4">
        <h2
            class="text-brand-secondary text-4xl font-bold tracking-tight"
        >
            Research Areas
        </h2>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-brand-secondary h-10 w-10 md:h-14 md:w-14"
        >
            <path
                stroke="none"
                d="M0 0h24v24H0z"
                fill="none"></path>
            <path d="M12 12v.01"></path>
            <path
                d="M19.071 4.929c-1.562 -1.562 -6 .337 -9.9 4.243c-3.905 3.905 -5.804 8.337 -4.242 9.9c1.562 1.561 6 -.338 9.9 -4.244c3.905 -3.905 5.804 -8.337 4.242 -9.9"
            ></path>
            <path
                d="M4.929 4.929c-1.562 1.562 .337 6 4.243 9.9c3.905 3.905 8.337 5.804 9.9 4.242c1.561 -1.562 -.338 -6 -4.244 -9.9c-3.905 -3.905 -8.337 -5.804 -9.9 -4.242"
            ></path>
        </svg>
    </div>

    <div
        class="grid grid-cols-1 gap-16 bg-white md:grid-cols-2"
    >
        {
            areas.map((area) => (
                <ResearchAreaCard
                    title={area.title}
                    description={area.description}
                    image={area.image}
                    link={area.link}
                />
            ))
        }
    </div>
</section>
